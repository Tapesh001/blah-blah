  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "overrides": {
    "minimatch": "11.0.8"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "@types/node": "24.10.1",
    "@playwright/test": "1.65.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "eslint": "10.15.0",
    "typescript-eslint": "8.72.2",
    "prettier": "3.10.1"
  }
